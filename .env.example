NODE_ENV=development
PORT=3000
LOG_LEVEL=info
REQUEST_BODY_LIMIT=1mb
MEMORY_PROVIDER=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=replex_agent_runtime
MONGODB_MEMORY_COLLECTION=agent_memories

# LLM Provider Configuration
# Options: null, nvidia-nim, openai, anthropic, gemini, deepseek
LLM_PROVIDER=nvidia-nim
LLM_API_KEY=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
LLM_MODEL=moonshotai/kimi-k2.6
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60000
LLM_MAX_RETRIES=3
LLM_RATE_LIMIT_RPM=60

# RAG Configuration
# RAG_PROVIDER: null | semantic
RAG_PROVIDER=semantic

# Embedding Provider Configuration
# Options: null, openai, nvidia-nim
EMBEDDING_PROVIDER=nvidia-nim
EMBEDDING_API_KEY=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
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
EMBEDDING_DIMENSIONS=1536

# Vector Store Configuration
# Options: null, mongo-atlas
VECTOR_STORE_PROVIDER=mongo-atlas
RAG_COLLECTION_NAME=rag_vectors
RAG_DEFAULT_TOP_K=5
RAG_MIN_SCORE=0.3
