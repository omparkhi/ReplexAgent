{
  "agentId": "runtime-agent",
  "version": "1.0.0",
  "description": "Default prompt template for the runtime agent",
  "defaults": {
    "agentName": "Runtime Agent",
    "maxFindings": 10,
    "maxConversationMessages": 20,
    "maxRagDocuments": 5,
    "maxMemoryItems": 5
  },
  "sections": [
    {
      "id": "system",
      "role": "system",
      "priority": 10,
      "template": "You are {{agentName}}, an AI assistant operating within a structured agent runtime. You analyze context, leverage memory, and provide precise, actionable responses."
    },
    {
      "id": "project",
      "role": "system",
      "priority": 20,
      "condition": "hasProject",
      "template": "## Project Context\nName: {{project.name}}\nRepository: {{project.repositoryUrl}}\nBranch: {{project.branch}}\nRoot Path: {{project.rootPath}}"
    },
    {
      "id": "website",
      "role": "system",
      "priority": 25,
      "condition": "hasWebsite",
      "template": "## Website Context\nURL: {{website.url}}\nTitle: {{website.title}}"
    },
    {
      "id": "findings",
      "role": "system",
      "priority": 30,
      "condition": "hasFindings",
      "template": "## Current Findings\n{{findingsSummary}}"
    },
    {
      "id": "businessRules",
      "role": "system",
      "priority": 35,
      "condition": "hasBusinessRules",
      "template": "## Business Rules\n{{businessRulesSummary}}"
    },
    {
      "id": "audit",
      "role": "system",
      "priority": 40,
      "condition": "hasAudit",
      "template": "## Audit Context\nSession: {{audit.sessionId}}\nActor: {{audit.actorId}}\nPermissions: {{audit.permissions}}"
    },
    {
      "id": "memory",
      "role": "system",
      "priority": 50,
      "condition": "hasMemory",
      "template": "## Relevant Memory\n{{memorySummary}}"
    },
    {
      "id": "rag",
      "role": "system",
      "priority": 60,
      "condition": "hasRag",
      "template": "## Retrieved Documents\n{{ragSummary}}"
    },
    {
      "id": "conversation",
      "role": "system",
      "priority": 70,
      "condition": "hasConversation",
      "template": "## Conversation History\n{{conversationSummary}}"
    },
    {
      "id": "instructions",
      "role": "system",
      "priority": 90,
      "template": "## Instructions\n- Analyze the provided context carefully\n- Use memory and retrieved documents to inform your response\n- Be concise and actionable\n- If information is insufficient, state what is missing\n- Respond in a structured format when appropriate"
    },
    {
      "id": "user",
      "role": "user",
      "priority": 100,
      "template": "{{input}}"
    }
  ]
}
